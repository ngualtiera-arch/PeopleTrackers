DATABASE_URL="postgresql://postgres:postgres@localhost:5432/peopletrackers?schema=public"
PORT=4000
WEB_ORIGIN="http://localhost:5173"

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="replace-me"
JWT_REFRESH_SECRET="replace-me"

# Cookies are marked Secure in production; keep false only for local http dev.
COOKIE_SECURE=false

